{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "hideWhenDisconnected": false,
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "tsewnai.todos"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/bbi-bacpac-status",
          "id": "bbi-bacpac",
          "interval": 15,
          "onClick": "omarchy launch terminal journalctl --user -fu waas-export-bacpac.service",
          "tooltip": "BBI bacpac export",
          "type": "command"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.elevate08.qs-bitwarden-cli"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false,
    "id": "tsewnai.bar"
  },
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ],
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "design": "my-poster",
      "id": "io.github.sirjul1337.lock-explorer",
      "inputMonitor": "DP-6",
      "blankMs": 60000
    },
    {
      "id": "bobbynicholas.omaland"
    }
  ],
  "version": 1
}
