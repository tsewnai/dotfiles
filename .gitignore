*.bak
*.bak.*

# Local backup dirs created before migrations (kept on disk, not in git)
backup-*/

# Written by omarchy itself into ~/.config/omarchy, which symlinks here
omarchy/defaults/
omarchy/hooks/post-update.d/

# Third-party shell plugins are git clones managed by `omarchy plugin`.
# Tracked as URLs in omarchy/plugins.txt and replayed by install.sh.
omarchy/plugins/*
# Hand-written plugins that live only in this repo stay tracked.
!omarchy/plugins/tsewnai.todos/
